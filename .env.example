# Database (Neon via Vercel Storage). Pull real values with `vercel env pull`.
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgres://user:password@host-pooler/db-name?sslmode=require"
# Direct connection, used by drizzle-kit migrations and scripts.
DATABASE_URL_UNPOOLED="postgres://user:password@host/db-name?sslmode=require"

# Base URL of the deployed app, for building absolute links.
PUBLIC_APP_URL="http://localhost:5173"

# Email (phase 2), Resend. Without these in dev, emails print to the server console.
RESEND_API_KEY=""
EMAIL_FROM=""

# Rate limiting (Upstash). Unset falls back to a per-instance in-memory limiter,
# fine locally, best effort on serverless. Set both in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Evidence storage (phase 4). Vercel Blob token.
BLOB_READ_WRITE_TOKEN=""

# Error monitoring (phase 5). Public DSN, safe in client bundles.
PUBLIC_SENTRY_DSN=""
PUBLIC_SENTRY_ENVIRONMENT=""
